{
  "$description": "Cheerkit's default component theme tokens. Hosts can override the corresponding --ck-* custom properties.",
  "light": {
    "color": {
      "background": { "$type": "color", "$value": "#f3f0e8" },
      "surface": { "$type": "color", "$value": "#fbfaf6" },
      "text": { "$type": "color", "$value": "#1f1e1b" },
      "text-muted": { "$type": "color", "$value": "#5f5b52" },
      "border": { "$type": "color", "$value": "#ddd7ca" },
      "primary": { "$type": "color", "$value": "#1c2b4a" },
      "on-primary": { "$type": "color", "$value": "#ffffff" },
      "danger": { "$type": "color", "$value": "#b42318" },
      "success": { "$type": "color", "$value": "#1e6b45" },
      "warning": { "$type": "color", "$value": "#8a5a00" }
    },
    "font": { "family": { "$type": "fontFamily", "$value": "inherit" } },
    "font-size": {
      "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
    },
    "radius": {
      "card": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "control": {
        "$type": "dimension",
        "$value": { "value": 10, "unit": "px" }
      }
    },
    "border": {
      "width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } }
    }
  },
  "dark": {
    "color": {
      "background": { "$type": "color", "$value": "#161616" },
      "surface": { "$type": "color", "$value": "#1f1f1f" },
      "text": { "$type": "color", "$value": "#f2f0ea" },
      "text-muted": { "$type": "color", "$value": "#a8a49a" },
      "border": { "$type": "color", "$value": "#363431" },
      "primary": { "$type": "color", "$value": "#3d5d9e" },
      "on-primary": { "$type": "color", "$value": "#ffffff" },
      "danger": { "$type": "color", "$value": "#f97066" },
      "success": { "$type": "color", "$value": "#6cc08b" },
      "warning": { "$type": "color", "$value": "#e0b04b" }
    }
  }
}
